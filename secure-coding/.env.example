# 이 파일은 예시 템플릿입니다. 복사해서 .env 를 만들고 실제 값을 채우세요:
#   cp .env.example .env
# .env 는 .gitignore 로 커밋에서 제외됩니다. 실제 시크릿을 레포에 올리지 마세요.

# 애플리케이션 비밀키 — 세션 서명에 사용. 무작위로 생성할 것:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-64-hex-random

# 실행 환경: development | production  (production 에서는 DEBUG 비활성)
FLASK_ENV=development

# 세션 쿠키 Secure 플래그: HTTPS(ngrok) 배포 시 1, 로컬 http 테스트 시 0
SESSION_COOKIE_SECURE=0

# 세션 유효시간(초)
SESSION_LIFETIME=3600

# SQLite 데이터베이스 파일 경로
DATABASE=instance/market.db

# 업로드 저장 경로 및 최대 크기(bytes, 기본 2MB)
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=2097152

# 신고 임계치: 이 수 이상 신고되면 상품 차단 / 유저 휴면 전환
REPORT_THRESHOLD=5

# Rate limit 저장소 (기본 인메모리). 다중 워커 운영 시 redis://localhost:6379 등으로 설정
RATELIMIT_STORAGE_URI=memory://

# 최초 관리자 계정 시드 (최초 1회만 사용, 실제 비밀번호는 커밋 금지)
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=change-me-before-first-run

# ngrok authtoken 은 코드/레포에 넣지 말 것.
# 터미널에서 별도 설정:  ngrok config add-authtoken <YOUR_TOKEN>
